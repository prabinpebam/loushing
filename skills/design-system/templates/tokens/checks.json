{
  "$comment": "Contrast pairs check-tokens.mjs holds in every theme context (WCAG 2.2: 4.5 for text, 3 for non-text like focus rings and control outlines).",
  "contrast": [
    { "fg": "color.text", "bg": "color.bg", "min": 4.5 },
    { "fg": "color.text", "bg": "color.bg-raised", "min": 4.5 },
    { "fg": "color.text-muted", "bg": "color.bg", "min": 4.5 },
    { "fg": "color.text-muted", "bg": "color.bg-raised", "min": 4.5 },
    { "fg": "color.accent", "bg": "color.bg", "min": 4.5 },
    { "fg": "color.on-accent", "bg": "color.accent", "min": 4.5 },
    { "fg": "color.negative", "bg": "color.bg-raised", "min": 4.5 },
    { "fg": "color.positive", "bg": "color.bg-raised", "min": 4.5 },
    { "fg": "color.focus", "bg": "color.bg", "min": 3 }
  ]
}
