{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prabinpebam.github.io/loushing/schema/item-1.json",
  "title": "Loushing item v1",
  "type": "object",
  "required": ["schema", "id", "type", "title", "summary", "effects", "source", "files", "install", "changes", "url", "page", "parts", "related", "updated", "added"],
  "properties": {
    "schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "enum": ["skill", "kit", "stack"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "effects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "source": {
      "type": "object",
      "required": ["repo", "path", "commit", "url"],
      "properties": {
        "repo": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "url": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256", "role", "runs"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "role": { "type": "string" },
          "runs": { "type": "boolean" },
          "mode": { "enum": ["100644", "100755"] }
        },
        "additionalProperties": false
      }
    },
    "install": {
      "type": "object",
      "required": ["note", "plans"],
      "properties": {
        "note": { "type": "string" },
        "contract": { "type": "object" },
        "plans": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^[a-z-]+:(project|personal)$" },
          "additionalProperties": {
            "type": "object",
            "required": ["supported"],
            "properties": { "supported": { "type": "boolean" }, "git": { "type": "array", "items": { "type": "string" } }, "ask": { "type": "string" }, "command": { "type": ["string", "null"] }, "automation": { "type": "object" }, "reason": { "type": "string" }, "adds": { "type": "array" }, "next": { "type": "string" }, "dryRun": { "type": "boolean" }, "download": { "type": ["string", "object", "null"] }, "downloadSteps": { "type": "array", "items": { "type": "string" } } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "changes": { "type": "array", "items": { "type": "object", "required": ["date", "kind", "line"], "properties": { "date": { "type": "string" }, "kind": { "type": "string" }, "line": { "type": "string" } }, "additionalProperties": false } },
    "url": { "type": "string" },
    "page": { "type": "object", "required": ["markdown"], "properties": { "markdown": { "type": "string" } }, "additionalProperties": false },
    "parts": { "type": "array" },
    "related": { "type": "array" },
    "updated": { "type": "string" },
    "added": { "type": "string" },
    "useWhen": { "type": "array", "items": { "type": "string" } },
    "notFor": { "type": "array", "items": { "type": "string" } },
    "area": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "agents": { "type": "object", "additionalProperties": { "enum": ["tested", "expected", "unsupported"] } },
    "status": { "enum": ["experimental", "beta", "stable", "deprecated", "moved"] },
    "requires": { "type": "array" },
    "license": { "type": "string" },
    "licenseNote": { "type": "string" },
    "origin": { "type": "string" },
    "owner": { "type": "string" },
    "docs": { "type": ["string", "object"] },
    "examples": { "type": "array" },
    "members": { "type": "array" },
    "handoffs": { "type": "array" },
    "derivedFrom": { "type": "object" },
    "archive": { "$ref": "#/$defs/archive" }
  },
  "additionalProperties": false,
  "$defs": {
    "archive": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["url", "manifest", "sha256", "size", "root", "files"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "manifest": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "size": { "type": "integer", "minimum": 0 },
            "root": { "type": "string", "minLength": 1 },
            "files": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["blocked"],
          "properties": { "blocked": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    }
  }
}
