{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prabinpebam.github.io/loushing/schema/catalog-1.json",
  "title": "Loushing catalog v1",
  "type": "object",
  "required": ["schema", "catalogVersion", "generated", "items", "aliases", "removed"],
  "properties": {
    "schema": { "type": "string" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "generated": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["public", "private"] },
    "release": { "type": ["object", "null"] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "aliases": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } },
    "removed": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["date", "reason"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "reason": { "type": "string", "minLength": 1 },
          "instead": { "$ref": "#/$defs/id" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["repo", "path", "commit"],
      "properties": {
        "repo": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "title", "summary", "useWhen", "notFor", "area", "tags", "agents", "status", "version", "effects", "updated", "source", "url", "data"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["skill", "kit", "stack"] },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "useWhen": { "$ref": "#/$defs/strings" },
        "notFor": { "$ref": "#/$defs/strings" },
        "area": { "type": "string" },
        "tags": { "$ref": "#/$defs/strings" },
        "agents": {
          "type": "object",
          "required": ["tested", "expected", "unsupported"],
          "properties": { "tested": { "$ref": "#/$defs/strings" }, "expected": { "$ref": "#/$defs/strings" }, "unsupported": { "$ref": "#/$defs/strings" } },
          "additionalProperties": false
        },
        "status": { "enum": ["experimental", "beta", "stable", "deprecated", "moved"] },
        "version": { "type": ["string", "null"] },
        "effects": { "$ref": "#/$defs/strings" },
        "derivedFrom": { "type": "object" },
        "parts": { "type": "array" },
        "members": { "$ref": "#/$defs/strings" },
        "updated": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "url": { "type": "string" },
        "data": { "type": "string" },
        "archive": { "$ref": "#/$defs/archive" },
        "versions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/version" } },
        "channels": { "type": "object", "additionalProperties": { "$ref": "#/$defs/version" } }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": ["version", "source", "data"],
      "properties": { "version": { "type": ["string", "null"] }, "source": { "$ref": "#/$defs/source" }, "data": { "type": "string" } },
      "additionalProperties": false
    },
    "archive": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["url", "manifest", "sha256", "size", "root", "files"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "manifest": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "size": { "type": "integer", "minimum": 0 },
            "root": { "type": "string", "minLength": 1 },
            "files": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["blocked"],
          "properties": { "blocked": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    }
  }
}
