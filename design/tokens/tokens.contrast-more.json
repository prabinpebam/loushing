{
  "$description": "More contrast modifier: muted text and outlines move to full text strength.",
  "color": {
    "text-muted": {
      "$type": "color",
      "$value": "{color.text}",
      "$description": "Muted text at full strength"
    },
    "outline": {
      "$type": "color",
      "$value": "{color.text}",
      "$description": "Outlines at full strength"
    },
    "rule": {
      "$type": "color",
      "$value": "{color.text-muted}",
      "$description": "Dividers become visible"
    }
  }
}
