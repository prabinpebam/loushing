        },
        "$description": "The halo's blur radius, in px to match the drawn line"
      },
      "fade": {
        "$type": "duration",
        "$value": "{duration.slow}",
        "$description": "How long a cameo takes to fade in"
      },
      "ease": {
        "$type": "cubicBezier",
        "$value": "{ease.bounce}",
        "$description": "A cameo's playful settle"
      },
      "layer": {
        "$type": "number",
        "$value": "{layer.cameo}",
        "$description": "Where a cameo sits in the stack"
      }
    }
  }
}
