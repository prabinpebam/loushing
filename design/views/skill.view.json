{
  "$schema": "./view.schema.json",
  "layout": "item",
  "title": "{item.name}",
  "regions": {
    "header": [
      { "type": "item-header", "item": { "from": "item" } }
    ],
    "decide": [
      { "type": "effects-chips", "item": { "from": "item" } },
      { "type": "compat-grid", "item": { "from": "item" } },
      { "type": "adds-tree", "item": { "from": "item" } }
    ],
    "get": [
      { "type": "get-it-panel", "item": { "from": "item" } }
    ],
    "body": [
      { "type": "item-body", "item": { "from": "item" } }
    ],
    "related": [
      { "type": "works-with", "item": { "from": "item" } }
    ],
    "source": [
      { "type": "source-viewer", "item": { "from": "item" } }
    ]
  }
}
