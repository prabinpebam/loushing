{
  "$schema": "./scenes.schema.json",
  "rules": {
    "maxPerPage": 2,
    "maxInViewport": 1,
    "minGapViewports": 1.5,
    "historySize": 8,
    "statusesShown": ["approved", "draft"],
    "maxImagesPerPage": 3,
    "maxPartsPerSetPiece": 2,
    "maxPropsPerImage": 2,
    "minCandidatesPerZone": 1,
    "preferDaypart": true
  },
  "drawing": {
    "masterFactor": 1.67,
    "lineCssPx": 1.5,
    "lineTolerance": 0.2,
    "scaleTolerance": 0.1,
    "densities": [1, 2],
    "canvases": {"wide": "1024x640", "tall": "640x1024", "square": "816x816"},
    "sizes": {"sm": {"frameToken": "c.chopper.frame-sm", "frameCssPx": 56, "headCssPx": 20}, "md": {"frameToken": "c.chopper.frame-md", "frameCssPx": 96, "headCssPx": 34}, "lg": {"frameToken": "c.chopper.frame-lg", "frameCssPx": 160, "headCssPx": 56}}
  },
  "zones": {
    "masthead-edge": {"description": "The bottom edge of the Home masthead, to the side of the search box, never over it", "poses": ["peeking", "lying"], "size": "sm", "minBreakpoint": "md", "align": "end"},
    "gutter": {"description": "The empty side gutter beside the content column on very wide screens", "poses": ["sitting", "standing", "playing"], "size": "md", "minBreakpoint": "xl", "align": "either"},
    "section-break": {"description": "The reserved space between two page sections, beside the divider", "poses": ["running", "standing", "playing", "lying", "sitting"], "size": "sm", "minBreakpoint": "none", "align": "either"},
    "tile-peek": {"description": "Above the top edge of a tile that is not interactive (a stat or illustration tile); only head and paws show", "poses": ["peeking"], "size": "sm", "minBreakpoint": "md", "align": "either"},
    "footer-ledge": {"description": "Resting on the top edge of the footer", "poses": ["lying", "sitting", "standing", "playing"], "size": "sm", "minBreakpoint": "none", "align": "either"},
    "list-end": {"description": "After the last result of a long list, beside the end-of-list line", "poses": ["sitting", "lying", "standing"], "size": "md", "minBreakpoint": "none", "align": "either"},
    "empty-companion": {"description": "Beside the message of an empty state, the not-found page or a Gone page; never above or over it", "poses": ["sitting", "playing", "lying", "standing"], "size": "lg", "minBreakpoint": "none", "align": "end"}
  },
  "props": {
    "coral-ball": {"kind": "toy", "description": "A small coral ball, a little smaller than his head. His favourite; the same ball in every scene"},
    "striped-sock": {"kind": "household", "description": "A cream sock with coral stripes"},
    "stick": {"kind": "nature", "description": "A small twig-sized stick, light brown"},
    "butterfly": {"kind": "nature", "description": "A small pale-yellow butterfly, drawn as on the butterfly cast sheet"},
    "earth-clumps": {"kind": "effect", "description": "Three or four small clumps of brown earth"},
    "water-droplets": {"kind": "effect", "description": "A few small water droplets, pale blue-grey"},
    "falling-leaf": {"kind": "nature", "description": "One small autumn leaf, muted orange"},
    "cushion": {"kind": "household", "description": "A small round cushion, muted sage green"},
    "squeaky-bone": {"kind": "toy", "description": "A small squeaky toy bone, muted coral"},
    "water-bowl": {"kind": "household", "description": "A small steel-grey water bowl"},
    "slipper": {"kind": "household", "description": "One soft slipper, muted blue"},
    "blanket": {"kind": "household", "description": "A small knitted blanket, cream and sage"},
    "soap-bubbles": {"kind": "effect", "description": "Three or four soap bubbles, clear with a faint sheen"},
    "acorn": {"kind": "nature", "description": "One small acorn, brown, held by the squirrel"},
    "squeaky-duck": {"kind": "toy", "description": "A small yellow rubber squeaky duck, about the size of his head"},
    "rope-toy": {"kind": "toy", "description": "A knotted rope tug toy, cream and coral, about as long as he is"},
    "food-bowl": {"kind": "household", "description": "A small steel-grey food bowl, empty"},
    "leash": {"kind": "household", "description": "A coral leash with a loop handle"},
    "parcel-box": {"kind": "household", "description": "A brown cardboard delivery box with a strip of tape, flaps open, just big enough for him to sit in"},
    "couch": {"kind": "household", "description": "One end of a small sage-green couch, its arm and part of the seat, cut off cleanly where it leaves the frame"},
    "potted-plant": {"kind": "household", "description": "A leafy indoor plant in a terracotta pot, about his height"},
    "balcony-rail": {"kind": "household", "description": "A short length of dark grey metal balcony railing, cut off cleanly at both ends"},
    "sun-patch": {"kind": "effect", "description": "A soft pale-yellow patch of sunlight under him; the only ground shape allowed"},
    "sparrows": {"kind": "nature", "description": "Two small brown sparrows taking off, drawn as on the sparrow cast sheet"}
  },
  "cast": {
    "squirrel": {"description": "A small grey-brown squirrel with a big bushy tail; about two-thirds of Chopper's sitting height. Quick, cheeky and never caught", "sheet": "design/chopper/reference/cast-squirrel.png", "status": "planned"},
    "butterfly": {"description": "A small pale-yellow butterfly with soft grey markings; about the size of his ear", "sheet": "design/chopper/reference/cast-butterfly.png", "status": "planned"},
    "pigeons": {"description": "Two plump grey pigeons with a green-violet sheen on the neck; calm and entirely unbothered by him", "sheet": "design/chopper/reference/cast-pigeons.png", "status": "planned"},
    "sparrow": {"description": "A small brown sparrow; about the size of his head; always flying off, never caught", "sheet": "design/chopper/reference/cast-sparrow.png", "status": "planned"},
    "robot-vacuum": {"description": "A round, low, grey robot vacuum with one small light on top; a little wider than he is long. It never touches him", "sheet": "design/chopper/reference/cast-robot-vacuum.png", "status": "planned"}
  },
  "scenes": [
    {"id": "nap-curled", "action": "asleep, curled into a fluffy ball with his tail over his nose", "pose": "lying", "mood": "sleepy", "facing": "front", "zones": ["footer-ledge", "list-end", "section-break"], "renders": {"sm": {"status": "draft", "canvas": "wide", "source": "design/chopper/source/nap-curled.sm.png", "prompt": "design/chopper/source/nap-curled.sm.prompt.txt", "measured": {"lineCssPx": 1.5}}, "md": {"status": "draft", "canvas": "wide", "source": "design/chopper/source/nap-curled.md.png", "prompt": "design/chopper/source/nap-curled.md.prompt.txt", "measured": {"lineCssPx": 1.5}}}, "status": "active"},
    {"id": "nap-belly-up", "action": "asleep on his back, paws in the air, ears flopped out to the sides", "pose": "lying", "mood": "sleepy", "facing": "front", "zones": ["footer-ledge"], "renders": {"sm": {"status": "planned"}}, "status": "active"},
    {"id": "chin-on-ledge", "action": "lying flat with his chin resting on his front paws, eyes open, watching quietly", "pose": "lying", "mood": "normal", "facing": "front", "zones": ["footer-ledge", "section-break"], "renders": {"sm": {"status": "planned"}}, "status": "active"},
    {"id": "tail-chase", "action": "spinning in a circle chasing his own curly tail", "pose": "playing", "mood": "playful", "facing": "front", "zones": ["gutter", "empty-companion"], "renders": {"md": {"status": "planned"}, "lg": {"status": "draft", "canvas": "square", "source": "design/chopper/source/tail-chase.lg.png", "prompt": "design/chopper/source/tail-chase.lg.prompt.txt", "measured": {"lineCssPx": 1.5}}}, "status": "active"},
