    {"id": "ball-trot", "action": "trotting proudly with a small ball in his mouth", "pose": "running", "mood": "happy", "facing": "right", "zones": ["section-break"], "props": ["coral-ball"], "renders": {"sm": {"status": "planned"}}, "status": "active"},
    {"id": "sock-thief", "action": "running off with a stolen striped sock in his mouth, looking pleased with himself", "pose": "running", "mood": "playful", "facing": "left", "zones": ["section-break"], "props": ["striped-sock"], "renders": {"sm": {"status": "planned"}}, "status": "active"},
