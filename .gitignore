# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors and IDEs (keep shared VS Code settings if they are added later)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Environment files and local secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Build output, coverage and logs
_site/
dist/
# Generated tokens are committed: the site build reads them and CI checks they're current.
!design/tokens/dist/
dist.old-*/
dist.build-*/
.build-*/
build/
coverage/
*.log
*.tmp

# Chopper image drafts (only chosen, QA-passed images go to design/chopper/source/)
design/chopper/drafts/

# Agent working state (agent-orchestration's in-repo fallback for progress logs)
.agent-orchestration/
site/perf/runs/
site/validation/results/
